# ============================================================
# APEX UNIVERSITY — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # server-only, never expose

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...             # safe for browser
STRIPE_SECRET_KEY=sk_test_...                              # server-only, never expose
STRIPE_WEBHOOK_SECRET=whsec_...                            # from `stripe listen` or Stripe dashboard

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000                   # change to your domain in prod

# --- Optional: rate limiting ---
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
